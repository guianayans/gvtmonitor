# Porta HTTP exposta pelo backend/Express
PORT=3030

# Configuração SSH usada para se conectar ao servidor monitorado
SERVER_HOST=yanserver.ddns.net
SERVER_PORT=22
SERVER_USER=root
# Use apenas uma das opções abaixo
SERVER_PASSWORD=troque-por-uma-senha
SERVER_KEY_PATH=/root/.ssh/id_rsa

# Lista de serviços permitidos para ações (quando aplicável)
ALLOWED_SERVICES=docker,ssh,nginx
